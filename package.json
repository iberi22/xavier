{
  "name": "xavier-monorepo",
  "private": true,
  "version": "0.10.0-12-06-2026",
  "type": "module",
  "workspaces": [
    "panel-ui",
    "docs/site"
  ],
  "scripts": {
    "release": "standard-version",
    "workflow": "powershell ./scripts/workflow.ps1",
    "install:all": "pnpm install",
    "prebuild": "node scripts/update-version.js",
    "build": "pnpm --filter xavier-panel-ui build && pnpm --filter docs/site build",
    "build:panel": "pnpm --filter xavier-panel-ui build",
    "build:docs": "pnpm --filter docs/site build",
    "lint": "biome check ."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.5",
    "cron-validator": "^1.4.0",
    "js-yaml": "^4.2.0",
    "standard-version": "^9.5.0",
    "husky": "^9.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "astro@<6.4.6": ">=6.4.6",
      "undici@>=7.23.0 <7.28.0": ">=7.28.0",
      "undici@>=7.0.0 <7.28.0": ">=7.28.0"
    }
  }
}
