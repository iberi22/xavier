{
  "name": "xavier-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "panel-ui",
    "docs/site",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "build": "npm run build --workspace panel-ui && npm run build --workspace docs/site",
    "build:panel": "npm run build --workspace panel-ui",
    "build:docs": "npm run build --workspace docs/site",
    "lint": "eslint src/",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7"
  },
  "pnpm": {
    "overrides": {
      "@swal/ui": "file:../maloca/packages/swal-ui",
      "undici": "^7.29.0",
      "esbuild": "^0.28.1",
      "sharp": "^0.35.3"
    }
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}