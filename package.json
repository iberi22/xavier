{
  "name": "xavier-monorepo",
  "private": true,
  "version": "0.1.1",
  "workspaces": [
    "panel-ui",
    "docs/site"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "build": "npm run build --workspace panel-ui && npm run build --workspace docs/site",
    "build:panel": "npm run build --workspace panel-ui",
    "build:docs": "npm run build --workspace docs/site",
    "lint": "pnpm --filter xavier-panel-ui run biome:check && pnpm --filter xavier-panel-ui run typecheck",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
