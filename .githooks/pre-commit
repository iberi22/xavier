#!/bin/sh
# Pre-commit hook for Xavier
# Runs cargo fmt --check and cargo clippy before each commit.
# Install: git config core.hooksPath .githooks

set -e

echo "🚦 Pre-commit checks..."

# Check formatting
echo "→ cargo fmt --check"
cargo fmt --check 2>&1 | head -20
FMT_EXIT=$?
if [ $FMT_EXIT -ne 0 ]; then
    echo "❌ Formatting check failed. Run 'cargo fmt' to fix."
    exit $FMT_EXIT
fi

# Check clippy
echo "→ cargo clippy --all-targets --all-features -- -D warnings"
cargo clippy --all-targets --all-features -- -D warnings 2>&1 | tail -20
CLIPPY_EXIT=$?
if [ $CLIPPY_EXIT -ne 0 ]; then
    echo "❌ Clippy check failed. Fix warnings above."
    exit $CLIPPY_EXIT
fi

# Check Biome (Lint and Format for JS/TS)
echo "→ pnpm biome ci ."
pnpm biome ci . 2>&1 | tail -20
BIOME_EXIT=$?
if [ $BIOME_EXIT -ne 0 ]; then
    echo "❌ Biome check failed. Run 'pnpm biome check --write .' to fix auto-fixable issues."
    exit $BIOME_EXIT
fi

echo "✅ All pre-commit checks passed."
