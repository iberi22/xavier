#!/usr/bin/env pwsh
# pre-push hook: corre checks rápidos antes de pushear
# Para instalar: copiar a .git/hooks/pre-push

Write-Host "🔍 Running pre-push CI checks..." -ForegroundColor Cyan

# Solo checks rápidos (sin tests completos)
$result = & "$PSScriptRoot\..\ci-local.ps1" -fast 2>&1

if ($LASTEXITCODE -ne 0) {
    Write-Host "❌ Pre-push checks FAILED. Push bloqueado." -ForegroundColor Red
    Write-Host "   Corre '.\ci-local.ps1' para ver los errores" -ForegroundColor Yellow
    exit 1
}

Write-Host "✅ Pre-push checks passed. Pusheando..." -ForegroundColor Green
exit 0
