# syntax=docker/dockerfile:1
# Xavier - Headless Multi-Stage Docker Build (No UI, No Node.js)
# Target: < 40MB production image without frontend overhead
#
# Usage: docker build -f Dockerfile.headless -t xavier:headless .
#        docker run -p 8006:8006 xavier:headless

# Stage 1: Builder
FROM rust:1.94-bookworm AS builder

ARG FEATURES=ci-safe

WORKDIR /app

# Install ONLY what cargo/rustc need at build time
RUN apt-get update && apt-get install -y --no-install-recommends \
        protobuf-compiler \
        libssl-dev \
        pkg-config \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Copy source code (no panel-ui frontend build needed)
# NOTE: must mirror every path dependency / workspace member used by
# Cargo.toml (codegraph-types, crates/*, vendor/maloca-core).
COPY Cargo.toml Cargo.lock ./
COPY LICENSE ./
COPY benches/ benches/
COPY src/ src/
COPY code-graph/ code-graph/
COPY codegraph-types/ codegraph-types/
COPY crates/ crates/
COPY vendor/maloca-core/ vendor/maloca-core/
COPY panel-ui/src-tauri/ panel-ui/src-tauri/

# Build headless xavier binary with no default features or specified FEATURES
RUN cargo build --release --bin xavier -j 1 --no-default-features --features "${FEATURES}"

# Strip debug symbols to reduce binary size
RUN strip -s /app/target/release/xavier

# Stage 2: Runtime
FROM debian:bookworm-slim

ARG XAVIER_VERSION=0.0.1
LABEL org.opencontainers.image.version=$XAVIER_VERSION

# Runtime dependencies:
# - ca-certificates: for HTTPS/TLS certificate validation
# - libssl3: required by rusqlite bundled SQLite and OpenSSL-using deps
# - curl: for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Create data directory and drop root (see Dockerfile for rationale).
RUN useradd --create-home --shell /usr/sbin/nologin xavier \
    && mkdir -p /data /app \
    && chown -R xavier:xavier /data /app

WORKDIR /app

# Copy binary from builder stage
COPY --from=builder --chown=xavier:xavier /app/target/release/xavier /usr/local/bin/xavier

EXPOSE 8006

# Healthcheck against /ready (503 unless stores are actually ready).
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -fsS http://localhost:8006/ready || exit 1

ENV XAVIER_PORT=8006 \
    XAVIER_HOST=0.0.0.0 \
    XAVIER_URL=http://localhost:8006 \
    RUST_LOG=info \
    XAVIER_VERSION=${XAVIER_VERSION} \
    XAVIER_WORKSPACE_ID=default

# Run headless with --no-ui flag
USER xavier
CMD ["/usr/local/bin/xavier", "http", "--no-ui"]
