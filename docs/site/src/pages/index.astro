---
// Xavier Landing Page - Astro Static Generation
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Xavier | The Cognitive Memory Brain for AI Agents</title>
  <meta name="description" content="High-performance vector memory runtime for AI agents written in Rust. Sub-millisecond contextual recall, local-first, native HTTP, CLI, and MCP interfaces." />
  <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Inter:wght@100..900&family=JetBrains+Mono:wght@100..800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script is:inline>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "surface": "#0e1322",
            "surface-dim": "#0e1322",
            "surface-bright": "#343949",
            "surface-container-lowest": "#090e1c",
            "surface-container-low": "#161b2b",
            "surface-container": "#1a1f2f",
            "surface-container-high": "#25293a",
            "surface-container-highest": "#2f3445",
            "on-surface": "#dee1f7",
            "on-surface-variant": "#c7c4d7",
            "primary": "#bf7af0",
            "primary-light": "#e2b5ff",
            "primary-container": "#6b33a5",
            "secondary": "#22d3ee",
            "tertiary": "#4de082",
            "background": "#0a0f1e",
            "background-deep": "#060b14",
            "text-primary": "#f1f5f9",
            "text-muted": "#64748b",
            "code-bg": "#1e293b",
            "syntax-orange": "#fb923c",
            "syntax-green": "#4ade80",
            "glass-stroke": "rgba(255, 255, 255, 0.08)",
          },
          fontFamily: {
            display: ["Geist", "sans-serif"],
            body: ["Inter", "sans-serif"],
            code: ["JetBrains Mono", "monospace"],
          },
          fontSize: {
            "display": ["72px", { "lineHeight": "1.05", "letterSpacing": "-0.04em", "fontWeight": "800" }],
          },
          spacing: {
            "container-max": "1280px",
            "section-gap": "96px",
          }
        }
      }
    };
  </script>

  <style is:global>
    body {
      background: linear-gradient(180deg, #0a0f1e 0%, #060b14 100%);
      color: #dee1f7;
      overflow-x: hidden;
      font-family: 'Inter', sans-serif;
    }

    .glass-panel {
      background: rgba(255, 255, 255, 0.04);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .glass-panel:hover {
      border-color: rgba(99, 102, 241, 0.6);
      transform: translateY(-4px);
      box-shadow: 0 16px 36px -10px rgba(99, 102, 241, 0.25), 0 0 20px rgba(34, 211, 238, 0.1) inset;
    }

    .neon-glow {
      box-shadow: 0 0 25px rgba(99, 102, 241, 0.45);
    }

    .text-gradient {
      background: linear-gradient(135deg, #e2b5ff 0%, #bf7af0 50%, #22d3ee 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Chromatic Aberration Effect (Exact stitch edition matching) */
    .glitch-text {
      color: #ffffff;
      text-shadow: -2.5px 0px 0px #22d3ee, 2.5px 0px 0px #ff00ff;
    }

    .glitch-text-hero {
      color: #ffffff;
      text-shadow: -3px 0px 0px #22d3ee, 3px 0px 0px #ff00ff;
      letter-spacing: -0.04em;
    }

    .glitch-text-primary {
      color: #bf7af0;
      text-shadow: -2.5px 0px 0px #22d3ee, 2.5px 0px 0px #ff00ff;
    }

    .bg-grid {
      background-size: 40px 40px;
      background-image: linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                        linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
    }

    .cursor-blink::after {
      content: '_';
      animation: blink 1s step-end infinite;
    }
    @keyframes blink { 50% { opacity: 0; } }

    .reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.7s ease-out, transform 0.7s ease-out;
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .flow-line {
      stroke-dasharray: 8;
      animation: flowDash 15s linear infinite;
    }
    @keyframes flowDash {
      to { stroke-dashoffset: -500; }
    }
  </style>

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>

<body class="antialiased min-h-screen flex flex-col relative selection:bg-primary/30 selection:text-white">
  <!-- Interactive WebGL Neural Graph & Ambient Grid Background -->
  <div class="fixed inset-0 z-[-2] pointer-events-none opacity-40" id="bg-canvas-container"></div>
  <div class="fixed inset-0 bg-grid z-[-1] pointer-events-none"></div>

  <!-- Top Navigation Bar -->
  <nav class="bg-surface/60 backdrop-blur-xl border-b border-glass-stroke shadow-2xl fixed top-0 w-full z-50 transition-all duration-300">
    <div class="flex justify-between items-center w-full px-6 py-4 max-w-container-max mx-auto">
      <div class="flex items-center gap-3">
        <a href={`${baseUrl}/`} class="font-display text-2xl font-black tracking-tight text-white hover:opacity-90 transition-opacity flex items-center gap-2.5">
          <img src={`${baseUrl}/xavier-icon.png`} alt="Xavier Logo" class="w-8 h-8 rounded-lg object-contain shadow-lg border border-white/10" />
          <span class="glitch-text text-2xl font-black tracking-tighter">Xavier</span>
        </a>
        <span class="text-xs px-2 py-0.5 rounded-full bg-primary/20 text-primary-light border border-primary/30 font-code">v0.0.1</span>
      </div>

      <div class="hidden md:flex gap-6 items-center font-medium text-sm">
        <a class="text-on-surface-variant hover:text-white transition-colors" href="#how-it-works">How It Works</a>
        <a class="text-on-surface-variant hover:text-white transition-colors" href="#features">Features</a>
        <a class="text-on-surface-variant hover:text-white transition-colors" href="#terminal-demo">Interactive CLI</a>
        <a class="text-on-surface-variant hover:text-white transition-colors" href="#architecture">Architecture</a>
        <a class="text-on-surface-variant hover:text-white transition-colors" href="#mcp-tools">MCP Catalog</a>
        <a class="text-secondary hover:text-white transition-colors font-semibold" href={`${baseUrl}/guides/intro/`}>Documentation →</a>
      </div>

      <div class="flex gap-3 items-center">
        <a href="https://github.com/iberi22/xavier" target="_blank" rel="noreferrer" class="px-4 py-2 rounded-lg glass-panel text-sm text-on-surface font-code hover:bg-white/10 transition-colors flex items-center gap-2">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub
        </a>
        <a href={`${baseUrl}/guides/quick-start/`} class="px-4 py-2 rounded-lg bg-primary text-white text-sm font-semibold neon-glow hover:bg-primary-container transition-colors shadow-lg">
          Get Started
        </a>
      </div>
    </div>
  </nav>

  <main class="flex-grow pt-28 w-full flex flex-col items-center">
    <!-- SECTION 1: HERO -->
    <section class="reveal w-full max-w-container-max px-6 mb-section-gap pt-10 flex flex-col lg:flex-row items-center gap-12 min-h-[640px]">
      <div class="w-full lg:w-1/2 flex flex-col gap-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/30 text-xs font-code text-primary-light w-max">
          <span class="w-2 h-2 rounded-full bg-tertiary animate-pulse"></span>
          SWAL Ecosystem · GitCore 3.8.0 Compliant
        </div>

        <h1 class="font-display text-4xl sm:text-6xl lg:text-[72px] font-extrabold glitch-text-hero pb-2 leading-[1.08]">
          High-Performance Cognitive Architecture
        </h1>
        <p class="font-display text-lg sm:text-xl font-bold text-primary-light">
          The Cognitive Memory Brain for AI Agents
        </p>

        <p class="font-body text-lg text-on-surface-variant max-w-xl leading-relaxed">
          High-performance vector memory runtime written in Rust. Sub-millisecond contextual recall, local-first privacy, and native HTTP, CLI, and MCP interfaces.
        </p>

        <div class="flex flex-wrap gap-4 pt-2">
          <a href={`${baseUrl}/guides/installation/`} class="px-6 py-3.5 rounded-xl bg-primary text-white font-semibold flex items-center gap-2 neon-glow hover:bg-primary-container transition-all hover:scale-[1.02]">
            <span>Deploy Now</span>
            <span class="material-symbols-outlined text-lg">bolt</span>
          </a>
          <a href="https://github.com/iberi22/xavier" target="_blank" rel="noreferrer" class="px-6 py-3.5 rounded-xl glass-panel text-white font-semibold flex items-center gap-2 hover:bg-white/10 transition-all">
            <span>View Source</span>
            <span class="material-symbols-outlined text-lg">code</span>
          </a>
        </div>

        <!-- 3 Stats Counter -->
        <div class="grid grid-cols-3 gap-4 mt-6 pt-6 border-t border-glass-stroke">
          <div class="glass-panel p-4 rounded-xl flex flex-col">
            <span class="font-display text-2xl lg:text-3xl font-bold text-tertiary flex items-center">&lt;&nbsp;<span class="stat-counter" data-target="1">0</span>ms</span>
            <span class="font-code text-xs text-text-muted mt-1 uppercase tracking-wider">Recall Latency</span>
          </div>
          <div class="glass-panel p-4 rounded-xl flex flex-col">
            <span class="font-display text-2xl lg:text-3xl font-bold text-secondary"><span class="stat-counter" data-target="6">0</span>+</span>
            <span class="font-code text-xs text-text-muted mt-1 uppercase tracking-wider">AST Languages</span>
          </div>
          <div class="glass-panel p-4 rounded-xl flex flex-col">
            <span class="font-display text-2xl lg:text-3xl font-bold text-primary-light"><span class="stat-counter" data-target="3">0</span></span>
            <span class="font-code text-xs text-text-muted mt-1 uppercase tracking-wider">Core Interfaces</span>
          </div>
        </div>
      </div>

      <!-- Right Side: Terminal Simulation + Neural Visualizer Overlay -->
      <div class="w-full lg:w-1/2 relative h-[420px] sm:h-[480px] flex items-center justify-center">
        <div class="absolute inset-0 glass-panel rounded-2xl overflow-hidden flex flex-col shadow-2xl border border-primary/20">
          <div class="bg-surface-container-high h-11 w-full flex items-center px-4 gap-2 border-b border-glass-stroke">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
            <span class="ml-4 font-code text-xs text-text-muted">xavier@agent-node:~</span>
            <span class="ml-auto text-xs font-code px-2 py-0.5 rounded bg-primary/20 text-primary-light">swal/xavier:8006</span>
          </div>
          <div class="p-6 font-code text-xs sm:text-sm text-syntax-green flex-grow relative bg-code-bg/90 overflow-hidden flex flex-col justify-start">
            <div class="cursor-blink text-text-primary mb-3 text-sm font-semibold" id="hero-prompt-text">$ xavier recall "vector memory" --limit 3</div>
            <div class="flex flex-col gap-2.5 text-on-surface-variant font-code text-xs sm:text-sm" id="hero-output-text">
              <div class="p-2 rounded bg-surface-container-low/80 border border-glass-stroke flex items-start gap-2">
                <span class="text-tertiary font-bold">[0.98]</span>
                <span>Architecture decision: SQLite-vec + BM25 hybrid engine</span>
              </div>
              <div class="p-2 rounded bg-surface-container-low/80 border border-glass-stroke flex items-start gap-2">
                <span class="text-secondary font-bold">[0.94]</span>
                <span>Hybrid BM25 + semantic search with dynamic 1.5x zone boost</span>
              </div>
              <div class="p-2 rounded bg-surface-container-low/80 border border-glass-stroke flex items-start gap-2">
                <span class="text-primary-light font-bold">[0.91]</span>
                <span>Agent context compression reduces 40% active tokens</span>
              </div>
            </div>
            <div class="mt-auto pt-4 border-t border-glass-stroke flex items-center justify-between text-xs text-text-muted">
              <span>Status: <span class="text-tertiary font-semibold">Active Node ⚡</span></span>
              <span>Ed25519 BIP39-24 Key Authenticated</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: HOW IT WORKS (Scroll 3-step flow) -->
    <section id="how-it-works" class="reveal w-full max-w-container-max px-6 mb-section-gap flex flex-col gap-12">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-white">How Xavier Works</h2>
        <p class="font-body text-base text-on-surface-variant mt-3">From raw unstructured developer context to sub-millisecond agent decision routing.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        <!-- Card 1 -->
        <div class="glass-panel p-8 rounded-2xl flex flex-col gap-4 relative group">
          <div class="w-14 h-14 rounded-xl bg-primary/10 border border-primary/30 flex items-center justify-center text-primary-light mb-2 shadow-[0_0_20px_rgba(99,102,241,0.2)]">
            <span class="material-symbols-outlined text-3xl">database</span>
          </div>
          <span class="text-xs font-code text-primary-light uppercase tracking-wider font-semibold">Step 01</span>
          <h3 class="font-display text-xl font-bold text-white">Ingest & Store</h3>
          <p class="font-body text-sm text-on-surface-variant leading-relaxed">
            Add memories, code graphs, and multi-turn session contexts. Xavier embeds everything locally using SQLite-vec — zero cloud leakage, zero network latency.
          </p>
          <div class="mt-auto pt-4 text-xs font-code text-text-muted flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-primary"></span>
            <span>Local SQLite-vec · MMap IO</span>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="glass-panel p-8 rounded-2xl flex flex-col gap-4 relative group">
          <div class="w-14 h-14 rounded-xl bg-secondary/10 border border-secondary/30 flex items-center justify-center text-secondary mb-2 shadow-[0_0_20px_rgba(34,211,238,0.2)]">
            <span class="material-symbols-outlined text-3xl">manage_search</span>
          </div>
          <span class="text-xs font-code text-secondary uppercase tracking-wider font-semibold">Step 02</span>
          <h3 class="font-display text-xl font-bold text-white">Hybrid Recall</h3>
          <p class="font-body text-sm text-on-surface-variant leading-relaxed">
            BM25 keyword scoring merged with semantic vector search. Active workspace zones automatically receive a dynamic 1.5x boost for real-time relevance.
          </p>
          <div class="mt-auto pt-4 text-xs font-code text-text-muted flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-secondary"></span>
            <span>BM25 + Cosine Vector Fusion</span>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="glass-panel p-8 rounded-2xl flex flex-col gap-4 relative group">
          <div class="w-14 h-14 rounded-xl bg-tertiary/10 border border-tertiary/30 flex items-center justify-center text-tertiary mb-2 shadow-[0_0_20px_rgba(77,224,130,0.2)]">
            <span class="material-symbols-outlined text-3xl">hub</span>
          </div>
          <span class="text-xs font-code text-tertiary uppercase tracking-wider font-semibold">Step 03</span>
          <h3 class="font-display text-xl font-bold text-white">Multi-Interface Serve</h3>
          <p class="font-body text-sm text-on-surface-variant leading-relaxed">
            Native HTTP REST on <code class="text-primary-light">:8006</code>, Model Context Protocol (MCP) over SSE/Stdio, and full CLI. Works instantly with Cursor, Claude, and Hermes agents.
          </p>
          <div class="mt-auto pt-4 text-xs font-code text-text-muted flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-tertiary"></span>
            <span>MCP SSE/Stdio · REST · CLI</span>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: CORE FEATURES (3x2 Grid) -->
    <section id="features" class="reveal w-full max-w-container-max px-6 mb-section-gap flex flex-col gap-12">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-white">Architected for Autonomy</h2>
        <p class="font-body text-base text-on-surface-variant mt-3">Six core subsystems engineered in Rust for extreme reliability and zero external bloat.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Feature 1 -->
        <div class="glass-panel p-8 rounded-2xl flex flex-col gap-4 group">
          <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center text-primary-light group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-2xl">neurology</span>
          </div>
          <h3 class="font-display text-xl font-bold text-white">🧠 Hybrid Memory Engine</h3>
          <ul class="font-body text-sm text-on-surface-variant space-y-2">
            <li class="flex items-center gap-2"><span class="text-primary-light">›</span> Semantic vector search via SQLite-vec</li>
            <li class="flex items-center gap-2"><span class="text-primary-light">›</span> BM25 full-text keyword scoring</li>
            <li class="flex items-center gap-2"><span class="text-primary-light">›</span> Dynamic 1.5x zone boost for active contexts</li>
          </ul>
        </div>

        <!-- Feature 2 -->
        <div class="glass-panel p-8 rounded-2xl flex flex-col gap-4 group">
          <div class="w-12 h-12 rounded-lg bg-secondary/10 flex items-center justify-center text-secondary group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-2xl">account_tree</span>
          </div>
          <h3 class="font-display text-xl font-bold text-white">🕸️ Code Graph Intelligence</h3>
          <ul class="font-body text-sm text-on-surface-variant space-y-2">
            <li class="flex items-center gap-2"><span class="text-secondary">›</span> AST parsing for Rust, TS, Python, Go, Java, C/C++</li>
            <li class="flex items-center gap-2"><span class="text-secondary">›</span> Call chain analysis & reverse blast radius</li>
            <li class="flex items-center gap-2"><span class="text-secondary">›</span> Complexity hotspot & cycle detection</li>
          </ul>
        </div>

        <!-- Feature 3 -->
        <div class="glass-panel p-8 rounded-2xl flex flex-col gap-4 group">
          <div class="w-12 h-12 rounded-lg bg-tertiary/10 flex items-center justify-center text-tertiary group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-2xl">share</span>
          </div>
          <h3 class="font-display text-xl font-bold text-white">🌐 P2P Mesh Network</h3>
          <ul class="font-body text-sm text-on-surface-variant space-y-2">
            <li class="flex items-center gap-2"><span class="text-tertiary">›</span> QUIC / Iroh decentralized sync between nodes</li>
            <li class="flex items-center gap-2"><span class="text-tertiary">›</span> Offline SQLite queue with last-write-wins</li>
            <li class="flex items-center gap-2"><span class="text-tertiary">›</span> Ed25519 BIP39-24 cryptographic node identity</li>
          </ul>
        </div>

        <!-- Feature 4 -->
        <div class="glass-panel p-8 rounded-2xl flex flex-col gap-4 group">
          <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center text-primary-light group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-2xl">terminal</span>
          </div>
          <h3 class="font-display text-xl font-bold text-white">⚡ MCP Protocol Native</h3>
          <ul class="font-body text-sm text-on-surface-variant space-y-2">
            <li class="flex items-center gap-2"><span class="text-primary-light">›</span> Complete MCP JSON-RPC over Stdio & SSE</li>
            <li class="flex items-center gap-2"><span class="text-primary-light">›</span> Plug-and-play with Cursor and Claude Desktop</li>
            <li class="flex items-center gap-2"><span class="text-primary-light">›</span> 20+ built-in agent memory & search tools</li>
          </ul>
        </div>

        <!-- Feature 5 -->
        <div class="glass-panel p-8 rounded-2xl flex flex-col gap-4 group">
          <div class="w-12 h-12 rounded-lg bg-red-400/10 flex items-center justify-center text-red-400 group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-2xl">security</span>
          </div>
          <h3 class="font-display text-xl font-bold text-white">🛡️ Local-First Security</h3>
          <ul class="font-body text-sm text-on-surface-variant space-y-2">
            <li class="flex items-center gap-2"><span class="text-red-400">›</span> Zero external third-party cloud dependencies</li>
            <li class="flex items-center gap-2"><span class="text-red-400">›</span> Bearer token HTTP auth (<code class="text-xs">X-Xavier-Token</code>)</li>
            <li class="flex items-center gap-2"><span class="text-red-400">›</span> Ephemeral secret leasing & automatic zeroing</li>
          </ul>
        </div>

        <!-- Feature 6 -->
        <div class="glass-panel p-8 rounded-2xl flex flex-col gap-4 group">
          <div class="w-12 h-12 rounded-lg bg-secondary/10 flex items-center justify-center text-secondary group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-2xl">view_in_ar</span>
          </div>
