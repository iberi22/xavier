<p class="text-on-surface-variant pl-4">"content": "SQLite-vec unified storage engine",</p>
<p class="text-on-surface-variant pl-4">"provenance": "wave-8-context"</p>
<p class="text-syntax-green">}</p>
<p class="text-white mt-2">&gt; xavier_token_savings()</p>
<p class="text-tertiary">→ { "saved": "18,400 tokens", "sessions": 52, "compression_ratio": "1.65x" }</p>
      `,
      mesh: `
<p class="text-text-muted"># List decentralized P2P peers</p>
<p class="text-white">$ xavier mesh list</p>
<p class="text-tertiary">● peer-a3f2 (online) — last sync: 2s ago · 14 new vectors</p>
<p class="text-tertiary">● peer-c119 (online) — last sync: 8s ago · synced</p>
<br/>
<p class="text-text-muted"># Generate cryptographic node identity</p>
<p class="text-white">$ xavier node create</p>
<p class="text-secondary">→ Ed25519 identity created: node-8f4a-9b12... (BIP39-24 verified)</p>
      `
    };

    const terminalDisplay = document.getElementById('terminal-display');
    const tabButtons = document.querySelectorAll('.tab-btn');

    function loadTab(tabKey) {
      if (terminalDisplay && terminalData[tabKey]) {
        terminalDisplay.innerHTML = terminalData[tabKey].trim();
      }
      tabButtons.forEach(btn => {
        if (btn.dataset.tab === tabKey) {
          btn.className = "tab-btn px-3 py-1 rounded text-xs font-code font-semibold transition-all bg-primary text-white";
        } else {
          btn.className = "tab-btn px-3 py-1 rounded text-xs font-code font-semibold transition-all text-text-muted hover:text-white";
        }
      });
    }

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        loadTab(btn.dataset.tab);
      });
    });

    loadTab('memory');

    // 3. Scroll-Driven Reveals & Counter Animations
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');

          // Counters
          const counters = entry.target.querySelectorAll('.stat-counter');
          counters.forEach(counter => {
            const target = +counter.getAttribute('data-target');
            if (counter.dataset.animated !== "true") {
              counter.dataset.animated = "true";
              let count = 0;
              const inc = target / 40;
              const timer = setInterval(() => {
                count += inc;
                if (count >= target) {
                  counter.innerText = target;
                  clearInterval(timer);
                } else {
                  counter.innerText = Math.floor(count);
                }
              }, 25);
            }
          });

          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
  </script>
</body>
