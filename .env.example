# .env.example — Xavier runtime environment
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Only XAVIER_TOKEN is strictly required for HTTP auth; everything else has
# sane defaults. Settings can also live in `config/xavier.config.json`
# (non-secret config); env vars always win over the JSON file.
# Secret values may alternatively be resolved from the Clavis hardware vault.

# ── Core (required) ────────────────────────────────────────────────────────
# Master authentication token for HTTP REST routes (X-Xavier-Token / Bearer)
XAVIER_TOKEN=change-me-to-a-long-random-token
# HMAC secret used to derive/validate per-user tokens
XAVIER_TOKEN_SECRET=
# Workspace root for indexing and path-security checks (default: cwd)
XAVIER_WORKSPACE_DIR=.

# ── Server ─────────────────────────────────────────────────────────────────
# Bind address (CLI clients use it as fallback). Loopback by default: the node
# serves an authenticated API, so a wildcard bind publishes it to every
# interface. Set 0.0.0.0 only behind a trusted network or a reverse proxy.
XAVIER_HOST=127.0.0.1
# REST port
XAVIER_PORT=8006
# MCP JSON-RPC port when running `xavier http`
XAVIER_MCP_PORT=8100
# Base URL used by CLI/TUI/session autosave clients
XAVIER_URL=http://127.0.0.1:8006
# Path to TLS cert (optional HTTPS)
XAVIER_TLS_CERT=
# Path to TLS key
XAVIER_TLS_KEY=
# Espacio (isolated spaces) API. Default on; set off|0|false to disable
# (routes answer 503). Spaces live under the daemon state dir in spaces/.
XAVIER_SPACES=
# Per-request HTTP timeout in seconds for regular REST routes (default 10)
XAVIER_HTTP_TIMEOUT_SECS=
# Timeout in seconds for long-running bulk routes (/index, /scan, /reindex, sync, prune) (default 600)
XAVIER_BULK_TIMEOUT_SECS=
# Login attempts allowed per IP per minute before 429 (default 20; refill = rpm/60 per second)
XAVIER_AUTH_RATE_LIMIT=
# Memory writes per caller per minute (default 600; 0 disables)
XAVIER_MEMORY_WRITE_RPM=
# Requests per minute allowed on /v1/proxy/* per provider (default 60)
XAVIER_PROXY_RATE_LIMIT=

# ── LLM / Model providers (chat, chronicle, summaries) ────────────────────
# Provider: local | managedlocal | cloud | openrouter | anthropic | openai |
#           deepseek | minimax | gemini | groq | z.ai | opencode | disabled
XAVIER_MODEL_PROVIDER=local
# Model override (any provider)
XAVIER_LLM_MODEL=
# Defaults to "ollama"
XAVIER_LOCAL_LLM_API_KEY=
# Enables OpenRouter auto-detection if provider unset
XAVIER_OPENROUTER_API_KEY=
# e.g. z-ai/glm-5.2:free
XAVIER_OPENROUTER_MODEL=
XAVIER_OPENROUTER_URL=https://openrouter.ai/api/v1
XAVIER_CLOUD_LLM_MODEL=
XAVIER_CLOUD_LLM_URL=
# Model override for `xavier chronicle generate`
XAVIER_CHRONICLE_MODEL=
# Legacy alias of XAVIER_MODEL_PROVIDER
XAVIER_PROVIDER=
# Spend guard for paid providers
XAVIER_WEEKLY_BUDGET=
XAVIER_REQUEST_LIMIT=
XAVIER_REQUEST_UNIT_LIMIT=
# Generic API key override applied to whichever provider is selected (secret)
# XAVIER_LLM_API_KEY=
# Wire protocol spoken by the local/cloud provider (default openai-compatible)
# openai-compatible | anthropic-compatible
XAVIER_API_FLAVOR=
# Base URL of the local OpenAI-compatible provider (default http://127.0.0.1:11435/v1)
XAVIER_LOCAL_LLM_URL=
# Base URL of the local Anthropic-Messages provider (default http://localhost:11434)
XAVIER_LOCAL_ANTHROPIC_URL=
# Model for the local provider; checked after XAVIER_LLM_MODEL
# (default qwen3-coder for provider=local, qwen2.5-coder:7b for provider=managedlocal)
XAVIER_LOCAL_LLM_MODEL=
# Model for the z.ai cloud provider (default glm-5.1)
XAVIER_ZAI_MODEL=
# Model delegated to the OpenCode CLI provider (default opencode/deepseek-v4-flash)
XAVIER_OPENCODE_MODEL=

# LLM proxy circuit breaker
# Consecutive provider failures that open the circuit (default 3)
XAVIER_CB_FAILURES=
# Seconds the circuit stays open before probing the provider again (default 60)
XAVIER_CB_OPEN_SECS=

# ── Embeddings ─────────────────────────────────────────────────────────────
# local (gllm) | ollama | openai-compatible
XAVIER_EMBEDDER=local
# Embedding backend selected/validated at startup, same vocabulary as XAVIER_EMBEDDER
# ollama | openai | local | cloud | auto | disabled (+ gllm when built with local-gllm)
XAVIER_EMBED_PROVIDER=
# High-level mode: local | local-gllm | cloud | auto | disabled (default local)
XAVIER_EMBEDDING_PROVIDER_MODE=
# OpenAI-compatible embeddings endpoint
XAVIER_EMBEDDING_URL=
# Local embedder URL (Ollama default :11434); single-retry fallback when cloud embedding fails
XAVIER_EMBEDDING_LOCAL_URL=
# e.g. nomic-embed-text / embeddinggemma / bge-small-en-v1.5
XAVIER_EMBEDDING_MODEL=
# Model for the local embedder only; falls back to XAVIER_EMBEDDING_MODEL (default embeddinggemma)
XAVIER_EMBEDDING_LOCAL_MODEL=
# Model for the cloud embedder only; falls back to XAVIER_EMBEDDING_MODEL (default text-embedding-3-small)
XAVIER_EMBEDDING_CLOUD_MODEL=
# Embedding model baked into the active systemd unit; `xavier doctor` uses it as a
# last-resort expectation when XAVIER_EMBEDDING_MODEL and the config are empty
# (default: embeddinggemma)
XAVIER_SYSTEMD_EMBEDDING_MODEL=
XAVIER_EMBEDDING_DIMENSIONS=384
# Local model name for gllm backend
XAVIER_GLLM_MODEL=
# Required path when gllm model is a file
XAVIER_GLLM_MODEL_PATH=
XAVIER_GLLM_DIMENSION=
XAVIER_EMBEDDING_TIMEOUT_SECS=
# openai-compatible | gemini
XAVIER_EMBEDDING_API_FLAVOR=
XAVIER_EMBEDDING_API_KEY=
# Timeout in ms before degrading to fast BM25/FTS search
XAVIER_EMBEDDING_FALLBACK_BUDGET_MS=2000
XAVIER_MANAGED_GOOGLE_EMBEDDINGS=false

# Embedder circuit breaker
# Consecutive embedding failures that open the circuit (default 5)
XAVIER_EMBEDDER_CB_THRESHOLD=
# Seconds the embedding circuit stays open before retrying (default 60)
XAVIER_EMBEDDER_CB_COOLDOWN_SECS=

# Ollama embedder (`XAVIER_EMBEDDER=ollama`)
# Embed endpoint (default http://localhost:11434/api/embed)
XAVIER_OLLAMA_URL=
# Ollama embedding model (default nomic-embed-text)
XAVIER_OLLAMA_MODEL=
# Vector width returned by the Ollama embedder (default 768)
XAVIER_OLLAMA_DIMS=

# Embedder request budget
# Per-attempt embedding timeout in ms; keep short so writes degrade to FTS (default 3000)
XAVIER_EMBEDDING_TIMEOUT_MS=

# Embedding cache (SQLite-backed LRU)
XAVIER_EMBEDDING_CACHE_ENABLED=true
# Default 10000; prod drop-in uses 80000 for measured working set (~19.4k Hermes records/cycle)
XAVIER_EMBEDDING_CACHE_CAPACITY=10000
# DEPRECATED alias of XAVIER_EMBEDDING_CACHE_CAPACITY, only read when CAPACITY is unset (default 10000)
# XAVIER_EMBEDDING_CACHE_SIZE=
# TTL in hours (default 24)
XAVIER_EMBEDDING_CACHE_TTL=24
# DEPRECATED: read only when XAVIER_EMBEDDING_CACHE_TTL is unset (default 24)
# XAVIER_EMBEDDING_CACHE_TTL_HOURS=24
XAVIER_EMBEDDING_CACHE_PERSIST=false
XAVIER_EMBEDDING_CACHE_DB_PATH=

# Reranker (optional second-stage retrieval)
XAVIER_RERANK_ENABLED=false
XAVIER_RERANK_ENDPOINT=
XAVIER_RERANK_API_KEY=
XAVIER_RERANK_MODEL=

# ── Storage / memory ───────────────────────────────────────────────────────
# Runtime data root (DBs live here)
XAVIER_DATA_DIR=data
# Explicit state root for node state (Maloca/Atlas stores, session state)
# default: settings.memory.data_dir, else "data"
XAVIER_STATE_DIR=
# sqlite | postgres
XAVIER_MEMORY_BACKEND=sqlite
XAVIER_MEMORY_SQLITE_PATH=
XAVIER_MEMORY_VEC_PATH=
XAVIER_MEMORY_FILE_PATH=
# Required when MEMORY_BACKEND=postgres
XAVIER_POSTGRES_URL=
# Optional second Postgres project (Neon branch per node) for read fan-out (secret)
# XAVIER_POSTGRES_URL_2=
XAVIER_STORAGE_LIMIT_BYTES=
# true = load all docs at boot instead of lazy
XAVIER_MEMORY_EAGER_LOAD=false
XAVIER_WORKING_MEMORY_CAPACITY=
XAVIER_WORKING_LRU_THRESHOLD=
# Workspace id used by REST and CLI memory routes (default: default)
XAVIER_WORKSPACE_ID=
# Workspace id used by background jobs (GC, consolidation, session sync) (default: default)
XAVIER_DEFAULT_WORKSPACE_ID=
# Plan tier assumed by background jobs that do not carry one (default: community)
XAVIER_DEFAULT_PLAN=
# JSON store file used by the `file` memory backend (default: data/file_store.json)
XAVIER_FILE_STORE_PATH=
# Ordered fallback chain for memory reads (default: vec,supabase,file)
XAVIER_MEMORY_FALLBACK=
# Enterprise/multi-tenant database (default: data/enterprise.db)
XAVIER_ENTERPRISE_DB_PATH=
# Dataset root for training jobs (default: data/training/datasets)
XAVIER_DATASETS_DIR=

# Code-graph index
XAVIER_CODE_GRAPH_DB_PATH=
# Skip symbol embeddings during bulk indexing
XAVIER_CODE_GRAPH_SKIP_EMBED=1

# Mesh sync
# Comma-separated peer base URLs
XAVIER_PEERS=
# Shared token for peer auth
XAVIER_MESH_TOKEN=
XAVIER_NODE_TOKEN=
XAVIER_NODE_REGISTRY_PATH=
XAVIER_SYNC_INTERVAL_MS=
XAVIER_SYNC_TIMEOUT_MS=
XAVIER_SYNC_MAX_RETRIES=
# Sync lag above which a peer is considered degraded (default 30000)
XAVIER_SYNC_LAG_THRESHOLD_MS=
# Minimum ms between two peer health probes (default 1000)
XAVIER_SYNC_MIN_HEALTH_INTERVAL_MS=
# Delay between sync retries (default 1000)
XAVIER_SYNC_RETRY_DELAY_MS=
# Minimum save success ratio before sync is reported unhealthy (default 0.95)
XAVIER_SYNC_SAVE_OK_RATE_THRESHOLD=
# Peer visibility policy (default: local_only)
XAVIER_SYNC_POLICY=
# Ordered mesh transport fallback chain (default: libp2p,http,supabase)
XAVIER_MESH_FALLBACK=
# Automatic retry of lagging peers during health checks (default true; "0"/"false" disables)
XAVIER_MESH_AUTO_REPAIR=true

# ── Security ───────────────────────────────────────────────────────────────
XAVIER_JWT_SECRET=
# Fallback auth token, consulted only when XAVIER_TOKEN is unset (secret)
# XAVIER_AUTH_TOKEN=
# Alternative auth-token name recognised by `xavier doctor` / system scan as an
# XAVIER_TOKEN equivalent (secret)
# XAVIER_API_KEY=
# HardwareVault service name for the /auth/* JWT keypair + DB master key (default: "xavier-auth"). Override only for an isolated test/dev instance so it never reads or writes the machine's real xavier-auth keyring/`~/.xavier/secrets` entries (not scoped by XAVIER_STATE_DIR/XAVIER_DATA_DIR).
XAVIER_AUTH_VAULT_SERVICE=
# Encryption-at-rest master key material
XAVIER_SECRET_SYMMETRIC_KEY=
XAVIER_MASTER_KEY_NAME=
XAVIER_ENCRYPTION_AT_REST_ENABLED=false
# Node record key: 64 hex chars (32 bytes). Overrides $XAVIER_DATA_DIR/node/record.key (auto-generated 0600 on first use). Without either, records are stored WITHOUT encryption (warning logged).
XAVIER_RECORD_KEY=
# Recovery store for the node record key: KCV + manifest only, never keys (default: ~/.xavier/recovery).
XAVIER_RECOVERY_DIR=
# Sealed Google Drive OAuth credential dir (default: ~/.xavier/drive). Holds only an AES-GCM blob.
XAVIER_DRIVE_DIR=
# Google OAuth client for the native Drive backup connection. Only consulted when NO usable rclone remote exists; an existing remote is always reused so the backup timers are untouched.
# Scopes requested: drive.file ONLY (per-file access, never the full drive scope).
XAVIER_GOOGLE_CLIENT_ID=
# Optional: loopback/native clients are not confidential, so this may be left empty.
XAVIER_GOOGLE_CLIENT_SECRET=
# rclone config consulted (read-only) to reuse an existing remote before any OAuth flow.
RCLONE_CONFIG=
# Egress allowlist for outbound fetches
XAVIER_ALLOWED_DOMAINS=
# Ed25519 maintainer key (NEVER commit)
XAVIER_MAINTAINER_PRIVATE_KEY_HEX=
# Allow passing node tokens via the `xavier nodes provision --token` CLI flag
# (default: off; the flag is otherwise rejected)
XAVIER_ALLOW_CLI_TOKEN=
# ── `xavier keys` API key generation ──────────────────────────────────────
# Base prefix of generated API keys (lowercase [a-z0-9_], default: "xavier").
# Keys are minted as `<prefix>_live_<64 hex>` or `<prefix>_test_<64 hex>` from
# the OS CSPRNG (32 bytes = 256 bits).
XAVIER_KEY_PREFIX=
# Default lifetime in seconds applied when `xavier keys generate` gets no
# --ttl-secs (default: 7776000 = 90 days).
XAVIER_DEFAULT_KEY_TTL_SECS=
# Ed25519 public key (hex) used to verify commercial license tokens
# (default: built-in SWAL root verifying key; SWAL_LICENSE_PUBKEY takes precedence)
# XAVIER_LICENSE_PUBKEY=

# Classification / clearance policy
# Clearance applied to material that declares no level (default: Internal)
XAVIER_DEFAULT_CLEARANCE=
# Append-only JSONL audit of clearance-read decisions (default: data/security/clearance_audit.jsonl)
XAVIER_CLEARANCE_AUDIT_PATH=
# Mirror the clearance audit into SQLite; "0" disables the mirror (default: 1)
XAVIER_CLEARANCE_AUDIT_SQLITE=1
# Trust the `X-Clearance` request header for unauthenticated callers
# (default: off — the header is ignored unless set to 1/true/yes)
XAVIER_CLEARANCE_TRUST_HEADER=
# Inline JSON route policy: {"routes":[{"prefix":"/memory/export","required":"INTERNAL"}]}
# (default: data/security/route_clearance.json, then the binary's built-in rules)
# XAVIER_REQUIRED_CLEARANCE_ROUTES=

PDFIUM_DYNAMIC_LIB_PATH=

# Windows fallback for XAVIER_STATE_DIR/HOME when neither is set
USERPROFILE=

# add the tree-node arm to gating RRF (off = unchanged retrieval)
XAVIER_PAGEINDEX_ARM_ENABLED=false

# RRF weight of the arm vs the memory layers
XAVIER_PAGEINDEX_ARM_WEIGHT=1.0
# libpdfium directory or file for the `pageindex-pdfium` feature (needs API >= 6996;
# nixpkgs `pdfium-binaries` 7087 works). Falls back to PDFIUM_DYNAMIC_LIB_PATH when unset.

# ── PageIndex (hierarchical tree retrieval) ─────────────────────────────────────
# Tree store path (default: $XAVIER_DATA_DIR/pageindex.sqlite3, else ./pageindex.sqlite3).
XAVIER_PAGEINDEX_DB=
# Comma-separated directories `pageindex_index_document` may read `path` files from.
# Empty disables `path` ingest (inline `content` still works).

# Comma-separated directories `pageindex_index_document` may read `path` files from.
# Empty disables `path` ingest (inline `content` still works).
XAVIER_PAGEINDEX_INGEST_ROOTS=

# virtual page size for text/markdown
XAVIER_PAGEINDEX_LINES_PER_PAGE=60

# split threshold (optimize)
XAVIER_PAGEINDEX_MAX_NODE_TOKENS=6000

# per-tool response cap
XAVIER_PAGEINDEX_MAX_RESPONSE_CHARS=95000

# merge threshold (optimize)
XAVIER_PAGEINDEX_MIN_NODE_TOKENS=200

# nixpkgs `pdfium-binaries` 7087 works). Falls back to PDFIUM_DYNAMIC_LIB_PATH when unset.
XAVIER_PAGEINDEX_PDFIUM_LIB=

# summarize on ingest by default
XAVIER_PAGEINDEX_SUMMARIZE=false

# summary length
XAVIER_PAGEINDEX_SUMMARY_MAX_WORDS=60

# ── Skill Controller ───────────────────────────────────────────────────────────
# Canonical store outside discovery roots (default: $HOME/.hermes/skills).
# Replaces the Hermes store when set; unset/empty keeps the current behavior.
XAVIER_SKILL_STORE=

# ── PageIndex (hierarchical tree retrieval) ─────────────────────────────────────
# Tree store path (default: $XAVIER_DATA_DIR/pageindex.sqlite3, else ./pageindex.sqlite3).

# Secret store fallback
# Ordered secret-store chain (default: local,openbao,memory)
XAVIER_SECRET_FALLBACK=

# ── Telegram notifications (optional) ─────────────────────────────────────
XAVIER_TELEGRAM_ENABLED=false
XAVIER_TELEGRAM_BOT_TOKEN=
# Alias for XAVIER_TELEGRAM_BOT_TOKEN, read when the latter is unset (secret)
# XAVIER_TELEGRAM_TOKEN=
XAVIER_TELEGRAM_NOTIFICATION_CHAT_ID=

# ── Integrations (optional) ────────────────────────────────────────────────
# Xavier Cloud (encrypted backup + AI). PGHEART_* is canonical; the
# XAVIER_PGHEART_* spelling is accepted as an alias. `xavier cloud backup`
# encrypts on this device with XAVIER_CLOUD_BACKUP_PASSPHRASE (min 12 chars,
# not recoverable: the server never sees it) and uploads only ciphertext.
PGHEART_URL=
PGHEART_TOKEN=
PGHEART_INSTANCE_ID=
XAVIER_CLOUD_BACKUP_PASSPHRASE=
# Or read the passphrase from a 0600 file instead:
# XAVIER_CLOUD_BACKUP_PASSPHRASE_FILE=
XAVIER_SUPABASE_URL=
XAVIER_SUPABASE_KEY=
# Second Supabase project for 2x sharding; needs BOTH _2 vars to be set (secret)
# XAVIER_SUPABASE_URL_2=
# XAVIER_SUPABASE_KEY_2=

# ── Observability ──────────────────────────────────────────────────────────
XAVIER_LOG_LEVEL=info
# Default: ~/.xavier/logs
XAVIER_LOG_DIR=
XAVIER_LOG_RETENTION_DAYS=
XAVIER_TELEMETRY_DB_PATH=
# Hash-chained audit log for privileged writes (default true)
XAVIER_AUDIT_CHAIN_ENABLED=true
# Treat this node as a SWAL maintainer node (default true)
XAVIER_IS_MAINTAINER=true

# ── Stability (Wave S1) ────────────────────────────────────────────────────
# Universal agent session ingestion cadence in seconds (default 600; 0 disables loop)
XAVIER_INGESTION_INTERVAL_SECS=600
# Gestalt bus auto-capture event budget per window (default 60; 0 disables cap)
XAVIER_BUS_QUOTA_PER_WINDOW=60
# Sliding window duration in seconds for bus auto-capture quota (default 3600)
XAVIER_BUS_QUOTA_WINDOW_SECS=3600
# Agentic scanner cadence in seconds (default 21600 = 6h; 0 disables the scanner)
XAVIER_AGENT_SCANNER_INTERVAL=
# Background system scan (Ollama reachability) cadence in seconds (default 300)
XAVIER_SCAN_INTERVAL_SECS=
# Minutes between self-management cron cycles (default 5)
XAVIER_CRON_SLEEP_MINUTES=
# Deduplication window in seconds for outbound email notifications (default 300)
XAVIER_EMAIL_DEDUP_SECS=

# ── Session autosave (CLI/TUI) ─────────────────────────────────────────────
# Per-request timeout in ms when pushing a session to the server (default 3000)
XAVIER_AUTO_SAVE_TIMEOUT_MS=
# Verify each autosaved session by reading it back (default true; "1"/"true" only)
XAVIER_AUTO_VERIFY=true
# Directory for sessions that could not be pushed (default: failed-syncs)
XAVIER_FAILED_SYNCS_DIR=

# ── Agent discovery / panel ────────────────────────────────────────────────
# Path to agent-registry.toml (default: agent-registry.toml)
XAVIER_AGENT_REGISTRY=
# Root dir scanned for agent memory files
XAVIER_AGENTS_DIR=
# Serve a custom built panel from here
XAVIER_PANEL_UI_DIR=
# Panel state root (default: <workspace_dir>/data/workspaces/<id>/panel_threads)
XAVIER_PANEL_STORE_DIR=
XAVIER_SWAL_DIR=

# ── Retrieval tuning (advanced) ────────────────────────────────────────────
XAVIER_VECTOR_WEIGHT=
XAVIER_KEYWORD_WEIGHT=
XAVIER_RRF_K=
XAVIER_MIN_MATCH_SCORE=
XAVIER_ZONE_BOOST=
XAVIER_ZONE_PENALTY=
XAVIER_MAX_CONTEXT_TOKENS=
XAVIER_DISABLE_HYDE=false
# Enable HyDE query expansion in the rerank stage (default false; "true" only)
XAVIER_HYDE_ENABLED=false
# Global wall-clock budget in ms for an embedding-backed search (default 2000);
# on expiry the search degrades to cached BM25 results
XAVIER_SEARCH_DEADLINE_MS=
# Stage-4 second-pass query expansion (default: enabled; "0"/"false"/"off"/"no" disables)
XAVIER_SEARCH_EXPANSION=
# Half-life in days for the temporal recency boost (default 30)
XAVIER_TEMPORAL_HALF_LIFE_DAYS=

# ── Memory layers ──────────────────────────────────────────────────────────
# BM25 k1 for the working-memory index (default 1.5)
XAVIER_WORKING_BM25_K1=
# BM25 b (length normalisation) for the working-memory index (default 0.75)
XAVIER_WORKING_BM25_B=
# Turns before an episodic summary is written (default 10)
XAVIER_EPISODIC_SUMMARY_WINDOW=
# Max sessions retained in episodic memory (default 50)
XAVIER_MAX_EPISODIC_SESSIONS=
# Importance a key event must reach to be stored as episodic memory (default 0.5)
XAVIER_EPISODIC_MIN_EVENT_IMPORTANCE=
# Summarise episodic sessions with the LLM instead of heuristically (default false)
XAVIER_EPISODIC_LLM_SUMMARY_ENABLED=false
# Extract entities/relations on write (default true)
XAVIER_ENTITY_EXTRACTION_ENABLED=true
# Documents scanned by the QJL compaction pass (default 500)
XAVIER_QJL_THRESHOLD=

# ── Context regeneration budgets ───────────────────────────────────────────
# SessionStart Minimal — docs (default 3)
XAVIER_CTX_SS_MIN_DOCS=
# SessionStart Minimal — token budget (default 600)
XAVIER_CTX_SS_MIN_TOKENS=
# SessionStart Medium — docs (default 5)
XAVIER_CTX_SS_MED_DOCS=
# SessionStart Medium — token budget (default 1200)
XAVIER_CTX_SS_MED_TOKENS=
# SessionStart Maximum — docs (default 8)
XAVIER_CTX_SS_MAX_DOCS=
# SessionStart Maximum — token budget (default 2400)
XAVIER_CTX_SS_MAX_TOKENS=
# Precompact Minimal — docs (default 4)
XAVIER_CTX_PC_MIN_DOCS=
# Precompact Minimal — token budget (default 800)
XAVIER_CTX_PC_MIN_TOKENS=
# Precompact Medium — docs (default 7)
XAVIER_CTX_PC_MED_DOCS=
# Precompact Medium — token budget (default 1600)
XAVIER_CTX_PC_MED_TOKENS=
# Precompact Maximum — docs (default 10)
XAVIER_CTX_PC_MAX_DOCS=
# Precompact Maximum — token budget (default 3200)
XAVIER_CTX_PC_MAX_TOKENS=

# ── Query router ───────────────────────────────────────────────────────────
# Model for Direct/complexity-routed short answers (default opencode/minimax-m2.7)
XAVIER_ROUTER_FAST_MODEL=
# Model for high-priority memories and weak-retrieval queries (default opencode/deepseek-v4-pro)
XAVIER_ROUTER_QUALITY_MODEL=
# Model override for queries classified Complex (default: none)
XAVIER_ROUTER_COMPLEX_MODEL=
# Model override for queries classified Retrieved (default: none)
XAVIER_ROUTER_RETRIEVED_MODEL=
# Path to a routing-policy JSON; unset means no policy file
XAVIER_ROUTER_POLICY_PATH=
# Seconds between routing-policy reloads (default 300; the router's own
# fallback when unset/invalid is 30)
XAVIER_ROUTER_POLICY_REFRESH_SECS=

# ── TGD consolidation ──────────────────────────────────────────────────────
XAVIER_TGD_ENABLED=true
# Nightly consolidation cron expression (default: 0 0 2 * * *)
XAVIER_TGD_SCHEDULE=
# Average relevance below which consolidation is skipped (default 0.7)
XAVIER_TGD_CONFIDENCE_THRESHOLD=
# New history entries required before a consolidation run (default 20)
XAVIER_TGD_MIN_NEW_HISTORY=
# Refinement passes per run (default 3)
XAVIER_TGD_ITERATIONS=
# Step size of the consolidation update (default 0.1)
XAVIER_TGD_LEARNING_RATE=
# Confidence gain required to accept a refined consolidation (default 0.6)
XAVIER_TGD_REFINEMENT_THRESHOLD=
# Memories re-scored per refinement batch (default 5)
XAVIER_TGD_REFINEMENT_BATCH_SIZE=
# Repository root used by the nightly TGD job when no workspace is open (default: .)
XAVIER_ROOT=

# ── Code-graph sidecar & plugins ───────────────────────────────────────────
# Enable code-graph symbol indexing (referenced by onboarding guidance)
XAVIER_CODE_SCAN=
# Absolute path to the code-graph sidecar binary; unset means auto-discovery
# (target/{release,debug}, ~/.local/bin, ~/.xavier/plugins, PATH)
XAVIER_CODEGRAPH_BIN=
# Unix socket of a running code-graph sidecar (default: /tmp/codegraph.sock)
XAVIER_CODEGRAPH_UDS_PATH=
# Internal recursion guard set by the installer so child processes do not
# re-enter the sidecar build; never set this by hand
# XAVIER_CODEGRAPH_INSTALL_ACTIVE=
# Re-prompt for sidecar install consent, ignoring a stored "no" (1)
XAVIER_CODEGRAPH_REPROMPT=
# Path to a plugins.json registry index (default: bundled
# code-graph/fixtures/xavier-plugins/plugins.json)
XAVIER_PLUGINS_INDEX=
# Seconds before a plugin parse is killed and the chain falls through (default 30; 0 = default)
XAVIER_PLUGIN_PARSE_TIMEOUT_SECS=
# Seconds allowed for a plugin's protocol handshake at registration (default 3)
XAVIER_PLUGIN_PROBE_TIMEOUT_SECS=
# Benchmark dataset for `xavier regen` (default:
# scripts/benchmarks/datasets/internal_swal_openclaw_memory.json)
XAVIER_BENCHMARK_DATASET=

# ── Auto-improvement cycle deadlines (`xavier improve`) ──────────────────────
# Both are capped at 86400 (24h); non-numeric or zero values are ignored.
# Overall deadline for one full cycle (default 300)
XAVIER_IMPROVE_TOTAL_TIMEOUT_SECS=300
# Per-stage deadline: benchmark, validate, persist, re-measure (default 120)
XAVIER_IMPROVE_STAGE_TIMEOUT_SECS=120

# ── Development / testing only ─────────────────────────────────────────────
# Bypasses HTTP auth middleware. NEVER in prod
XAVIER_DEV_MODE=false
# Disable interactive TUI prompts
XAVIER_HEADLESS=false
# Render the TUI once into a test backend and exit (TUI smoke dumps; any value)
# XAVIER_TUI_DUMP=
# Initial tab index when XAVIER_TUI_DUMP is set (default 0)
# XAVIER_TUI_TAB=

# ── Config file resolution ─────────────────────────────────────────────────
# Explicit path to xavier.config.json / xavier.toml
# (default: config/xavier.config.json, else the first of
# ~/.config/xavier/xavier.toml, ~/.config/xavier/xavier.config.json that exists)
# This file is READ-ONLY DEFAULTS: the daemon never writes it, so it stays
# clean in git. Execution state the daemon learns (learned navigation policy,
# license acceptance, API settings saved at runtime) is written to the runtime
# state file below and overlaid on top of the defaults at boot.
# XAVIER_CONFIG_PATH=
# Where the daemon persists runtime/execution state
# (default: ~/.local/state/xavier/xavier.runtime.json, i.e. $XDG_STATE_HOME;
# when XAVIER_CONFIG_PATH is pinned, <its dir>/.xavier-state/xavier.runtime.json
# so a second instance never inherits the node's state). Never inside the repo.
# XAVIER_RUNTIME_STATE_PATH=
# Directory holding mesh_pairing_secrets.json and peer/ACL files
# (default: <os config dir>/xavier, i.e. ~/.config/xavier)
# XAVIER_CONFIG_DIR=

# ── Google OAuth2 / Colab compute access ────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8006/v1/auth/google/callback
GOOGLE_OAUTH_CLIENT_SECRET_CLAVIS_REF=clavis://google-oauth-secret

# ── OAuth2 providers managed by Xavier (generic, provider-agnostic) ─────────
# A provider is enabled only when BOTH its _CLIENT_ID and _CLIENT_SECRET are set.
# XAVIER_OAUTH_GOOGLE_CLIENT_ID=
# XAVIER_OAUTH_GOOGLE_CLIENT_SECRET=
# XAVIER_OAUTH_GITHUB_CLIENT_ID=
# XAVIER_OAUTH_GITHUB_CLIENT_SECRET=
# Origin the callback URLs are built from (default: http://localhost:8006)
XAVIER_OAUTH_REDIRECT_BASE=
# Secret used to sign the OAuth state parameter; falls back to XAVIER_TOKEN and
# finally to a built-in dev value, so set it in any real deployment (secret)
# XAVIER_OAUTH_STATE_SECRET=

# ── Xavier DocBot — Document Management & Bot Gateways ─────────────────────────

# --- Gateways ------------------------------------------------------------------
# Telegram (already in Xavier core — reused by DocBot)
# TELEGRAM_BOT_TOKEN=                  # set via: printf '%s' "$TOKEN" | xavier vault set telegram_bot_token
# comma-separated Telegram user IDs (empty = allow all)
DOCBOT_TELEGRAM_ALLOWED_IDS=

# WhatsApp Cloud API (Meta)
# permanent system user token
DOCBOT_WHATSAPP_TOKEN=
# sender phone number ID
DOCBOT_WHATSAPP_PHONE_NUMBER_ID=
# webhook verification secret
DOCBOT_WHATSAPP_VERIFY_TOKEN=xavier_docbot

# Discord (serenity — feature: discord)
DOCBOT_DISCORD_TOKEN=

# Slack (slack-morphism — feature: slack)
DOCBOT_SLACK_BOT_TOKEN=
DOCBOT_SLACK_APP_TOKEN=

# --- RAG LLM backend -----------------------------------------------------------
# Options: ollama (default, local-first) | openai | retrieval-only
DOCBOT_LLM_BACKEND=ollama
DOCBOT_OLLAMA_URL=http://localhost:11434
DOCBOT_OPENAI_URL=https://api.openai.com/v1
DOCBOT_OPENAI_API_KEY=
DOCBOT_LLM_MODEL=llama3.2
DOCBOT_LLM_MAX_TOKENS=1024
DOCBOT_LLM_TEMPERATURE=0.2

# --- Collections & Chunking ----------------------------------------------------
# target tokens per chunk
DOCBOT_DEFAULT_CHUNK_SIZE=512
# overlap tokens between chunks
DOCBOT_DEFAULT_CHUNK_OVERLAP=64
# hard limit per collection
DOCBOT_MAX_COLLECTION_DOCS=10000

# Durable event bus log retention (defaults: 7 days / 200000 rows)
XAVIER_EVENT_LOG_MAX_AGE_DAYS=
XAVIER_EVENT_LOG_MAX_ROWS=
# Working memory snapshot cadence in seconds (default 60, 0 disables)
XAVIER_WORKING_SNAPSHOT_INTERVAL_SECS=

# Opt-in session harvester: directory of agent sessions to ingest (unset = disabled)
XAVIER_HC_SESSIONS_DIR=

# --- Training jobs API (/v1/training/jobs) ---
# python interpreter used to run the trainer script
XAVIER_PYTHON=python3
# trainer script (default: scripts/training/train_expert.py resolved against the install root)
XAVIER_TRAIN_SCRIPT=
# max accepted GGUF upload size in bytes (default 4 GiB)
XAVIER_TRAIN_MAX_ARTIFACT_BYTES=4294967296
# hard wall-clock limit per job in seconds (default 21600; 0 = unlimited)
XAVIER_TRAIN_TIMEOUT=21600
# max simultaneous queued/running local jobs (default 1)
XAVIER_TRAIN_MAX_CONCURRENT=1
# Prune artifacts of finished training jobs older than N days (0 = keep forever);
# artifacts referenced by a non-retired mini-expert are never deleted
XAVIER_TRAIN_RETENTION_DAYS=30
# Total job artifacts budget in bytes (default 20 GiB, 0 = unlimited)
XAVIER_TRAIN_ARTIFACTS_BUDGET_BYTES=21474836480

# Space-scoped access tokens (xsp_): default lifetime in days (1-3650, default 90)
XAVIER_SPACE_TOKEN_TTL_DAYS=90
# Max cached per-space memory workspaces (LRU, default 64)
XAVIER_SPACE_WORKSPACE_CACHE_MAX=64
