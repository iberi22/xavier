# .env.example — Xavier runtime environment
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Only XAVIER_TOKEN is strictly required for HTTP auth; everything else has
# sane defaults. Settings can also live in `config/xavier.config.json`
# (non-secret config); env vars always win over the JSON file.
# Secret values may alternatively be resolved from the Clavis hardware vault.

# ── Core (required) ────────────────────────────────────────────────────────
# Master authentication token for HTTP REST routes (X-Xavier-Token / Bearer)
XAVIER_TOKEN=change-me-to-a-long-random-token
# HMAC secret used to derive/validate per-user tokens
XAVIER_TOKEN_SECRET=
# Workspace root for indexing and path-security checks (default: cwd)
XAVIER_WORKSPACE_DIR=.

# ── Server ─────────────────────────────────────────────────────────────────
XAVIER_HOST=127.0.0.1            # Bind address (CLI clients use it as fallback)
XAVIER_PORT=8006                 # REST port
XAVIER_MCP_PORT=8100             # MCP JSON-RPC port when running `xavier http`
XAVIER_URL=http://127.0.0.1:8006 # Base URL used by CLI/TUI/session autosave clients
XAVIER_TLS_CERT=                 # Path to TLS cert (optional HTTPS)
XAVIER_TLS_KEY=                  # Path to TLS key

# ── LLM / Model providers (chat, chronicle, summaries) ────────────────────
# Provider: local | managedlocal | cloud | openrouter | anthropic | openai |
#           deepseek | minimax | gemini | groq | z.ai | opencode | disabled
XAVIER_MODEL_PROVIDER=local
XAVIER_LLM_MODEL=                # Model override (any provider)
XAVIER_LOCAL_LLM_API_KEY=        # Defaults to "ollama"
XAVIER_OPENROUTER_API_KEY=       # Enables OpenRouter auto-detection if provider unset
XAVIER_OPENROUTER_MODEL=         # e.g. z-ai/glm-5.2:free
XAVIER_OPENROUTER_URL=https://openrouter.ai/api/v1
XAVIER_CLOUD_LLM_MODEL=
XAVIER_CLOUD_LLM_URL=
XAVIER_CHRONICLE_MODEL=          # Model override for `xavier chronicle generate`
XAVIER_PROVIDER=                 # Legacy alias of XAVIER_MODEL_PROVIDER
XAVIER_WEEKLY_BUDGET=            # Spend guard for paid providers
XAVIER_REQUEST_LIMIT=
XAVIER_REQUEST_UNIT_LIMIT=

# ── Embeddings ─────────────────────────────────────────────────────────────
XAVIER_EMBEDDER=local            # local (gllm) | ollama | openai-compatible
XAVIER_EMBEDDING_URL=            # OpenAI-compatible embeddings endpoint
XAVIER_EMBEDDING_LOCAL_URL=      # Local embedder URL (Ollama default :11434); single-retry fallback when cloud embedding fails
XAVIER_EMBEDDING_MODEL=          # e.g. nomic-embed-text / embeddinggemma / bge-small-en-v1.5
XAVIER_EMBEDDING_DIMENSIONS=384
XAVIER_GLLM_MODEL=               # Local model name for gllm backend
XAVIER_GLLM_MODEL_PATH=          # Required path when gllm model is a file
XAVIER_GLLM_DIMENSION=
XAVIER_EMBEDDING_TIMEOUT_SECS=
XAVIER_EMBEDDING_API_FLAVOR=     # openai-compatible | gemini
XAVIER_EMBEDDING_API_KEY=
XAVIER_EMBEDDING_FALLBACK_BUDGET_MS=2000 # Timeout in ms before degrading to fast BM25/FTS search
XAVIER_MANAGED_GOOGLE_EMBEDDINGS=false

# Embedding cache (SQLite-backed LRU)
XAVIER_EMBEDDING_CACHE_ENABLED=true
XAVIER_EMBEDDING_CACHE_CAPACITY=10000
XAVIER_EMBEDDING_CACHE_TTL_HOURS=24
XAVIER_EMBEDDING_CACHE_PERSIST=false
XAVIER_EMBEDDING_CACHE_DB_PATH=

# Reranker (optional second-stage retrieval)
XAVIER_RERANK_ENABLED=false
XAVIER_RERANK_ENDPOINT=
XAVIER_RERANK_API_KEY=
XAVIER_RERANK_MODEL=

# ── Storage / memory ───────────────────────────────────────────────────────
XAVIER_DATA_DIR=data             # Runtime data root (DBs live here)
XAVIER_MEMORY_BACKEND=sqlite     # sqlite | postgres
XAVIER_MEMORY_SQLITE_PATH=
XAVIER_MEMORY_VEC_PATH=
XAVIER_MEMORY_FILE_PATH=
XAVIER_POSTGRES_URL=             # Required when MEMORY_BACKEND=postgres
XAVIER_STORAGE_LIMIT_BYTES=
XAVIER_MEMORY_EAGER_LOAD=false   # true = load all docs at boot instead of lazy
XAVIER_WORKING_MEMORY_CAPACITY=
XAVIER_WORKING_LRU_THRESHOLD=

# Code-graph index
XAVIER_CODE_GRAPH_DB_PATH=
XAVIER_CODE_GRAPH_SKIP_EMBED=1   # Skip symbol embeddings during bulk indexing

# Mesh sync
XAVIER_PEERS=                    # Comma-separated peer base URLs
XAVIER_MESH_TOKEN=               # Shared token for peer auth
XAVIER_NODE_TOKEN=
XAVIER_NODE_REGISTRY_PATH=
XAVIER_SYNC_INTERVAL_MS=
XAVIER_SYNC_TIMEOUT_MS=
XAVIER_SYNC_MAX_RETRIES=

# ── Security ───────────────────────────────────────────────────────────────
XAVIER_JWT_SECRET=
XAVIER_SECRET_SYMMETRIC_KEY=     # Encryption-at-rest master key material
XAVIER_MASTER_KEY_NAME=
XAVIER_ENCRYPTION_AT_REST_ENABLED=false
XAVIER_ALLOWED_DOMAINS=          # Egress allowlist for outbound fetches
XAVIER_MAINTAINER_PRIVATE_KEY_HEX=  # Ed25519 maintainer key (NEVER commit)

# ── Telegram notifications (optional) ─────────────────────────────────────
XAVIER_TELEGRAM_ENABLED=false
XAVIER_TELEGRAM_BOT_TOKEN=
XAVIER_TELEGRAM_NOTIFICATION_CHAT_ID=

# ── Integrations (optional) ────────────────────────────────────────────────
XAVIER_PGHEART_URL=
XAVIER_PGHEART_TOKEN=
XAVIER_SUPABASE_URL=
XAVIER_SUPABASE_KEY=

# ── Observability ──────────────────────────────────────────────────────────
XAVIER_LOG_LEVEL=info
XAVIER_LOG_DIR=                  # Default: ~/.xavier/logs
XAVIER_LOG_RETENTION_DAYS=
XAVIER_TELEMETRY_DB_PATH=

# ── Agent discovery / panel ────────────────────────────────────────────────
XAVIER_AGENTS_DIR=               # Root dir scanned for agent memory files
XAVIER_PANEL_UI_DIR=             # Serve a custom built panel from here
XAVIER_SWAL_DIR=

# ── Retrieval tuning (advanced) ────────────────────────────────────────────
XAVIER_VECTOR_WEIGHT=
XAVIER_KEYWORD_WEIGHT=
XAVIER_RRF_K=
XAVIER_MIN_MATCH_SCORE=
XAVIER_ZONE_BOOST=
XAVIER_ZONE_PENALTY=
XAVIER_MAX_CONTEXT_TOKENS=
XAVIER_DISABLE_HYDE=false

# ── Development / testing only ─────────────────────────────────────────────
XAVIER_DEV_MODE=false            # Bypasses HTTP auth middleware. NEVER in prod
XAVIER_HEADLESS=false            # Disable interactive TUI prompts
