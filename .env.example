# Xavier credentials and secrets only.
# Non-secret runtime configuration lives in config/xavier.config.json.
#
# You can override any config value at runtime by setting the corresponding
# XAVIER_* environment variable — it takes precedence over the config file.

# Core auth
XAVIER_TOKEN=replace-with-a-long-random-token

# Provider API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
GEMINI_API_KEY=

# Supabase Memory Store (optional — provide your own instance)
XAVIER_SUPABASE_URL=
XAVIER_SUPABASE_KEY=

# --- LOCAL-FIRST (Ollama) ---
# Active model provider for LLM chat.
# Value: "local" (runs LLM via local provider like Ollama), "cloud" (OpenAI, Anthropic, etc.), "opencode", or "disabled".
# Default recommended: local
XAVIER_MODEL_PROVIDER=local

# Base URL of the local LLM endpoint (Ollama OpenAI-compatible API).
# Default: http://localhost:11434/v1
XAVIER_LOCAL_LLM_URL=http://localhost:11434/v1

# Local LLM model for chat and context routing.
# Default: qwen3-coder
XAVIER_LOCAL_LLM_MODEL=qwen3-coder

# Active mode for generating embeddings.
# Value: "local" (Ollama), "local-gllm" (in-process candle GLLM), "cloud" (OpenAI), "auto", or "disabled".
# Default: local
XAVIER_EMBEDDING_PROVIDER_MODE=local

# Embedding model to generate context vectors.
# Default: embeddinggemma
XAVIER_EMBEDDING_MODEL=embeddinggemma

# Host address where Ollama is bound.
# Ollama respects this natively when launching "ollama serve".
# Default: 127.0.0.1:11434
OLLAMA_HOST=127.0.0.1:11434

# Native Ollama Embedding Provider Configuration
# Provider selection: "ollama" or "openrouter"
XAVIER_EMBED_PROVIDER=ollama
XAVIER_OLLAMA_URL=http://localhost:11434/api/embed
XAVIER_OLLAMA_MODEL=nomic-embed-text
XAVIER_OLLAMA_DIMS=768

# --- CIRCUIT BREAKER CONFIGURATION (Issue 11 Placeholder) ---
# Configures circuit breakers on service failures.
# XAVIER_CB_FAILURES=3
# XAVIER_CB_OPEN_SECS=30

