#!/usr/bin/env bash
# Xavier robust pre-commit hook: ensures format, lints, privacy and integrity gates pass before committing.
set -euo pipefail

echo "🛡️  [Xavier Pre-Commit] Running local gates..."

# 1. Anti-fuga de estrategia/economia/PII (auditoria 2026-09-10)
if [ -f "scripts/check-strategy-leak.sh" ]; then
    bash scripts/check-strategy-leak.sh --staged || {
        echo "❌ [Pre-Commit] Falla en check-strategy-leak. Corrige los archivos antes de commitear."
        exit 1
    }
fi

# 2. Revisa si hay cambios en archivos Rust staged
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.rs$' || true)
if [ -n "$STAGED_RS" ]; then
    echo "🦀 [Pre-Commit] Verificando formato de Rust (cargo fmt)..."
    cargo fmt --all -- --check || {
        echo "❌ [Pre-Commit] Error de formato en Rust. Ejecuta 'cargo fmt --all' antes de commitear."
        exit 1
    }

    # clippy compiles the whole workspace (minutes, GBs): it runs in CI and in the agent loop.
    # Remote agents (e.g. Jules) cannot build this workspace, so the hook stays light by default.
    if [ "${XAVIER_HOOK_FULL:-0}" = "1" ]; then
        echo "🦀 [Pre-Commit] Verificando clippy (-D warnings)..."
        CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-/tmp/xavier-precommit-target}" cargo clippy -p xavier -p code-graph --all-targets -- -D warnings || {
            echo "❌ [Pre-Commit] Fallo en cargo clippy. Corrige las advertencias/errores antes de commitear."
            exit 1
        }
    else
        echo "ℹ️  [Pre-Commit] clippy lo corre CI (XAVIER_HOOK_FULL=1 para correrlo aquí)."
    fi
fi

# 3. Revisa si hay cambios en panel-ui staged
STAGED_UI=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^panel-ui/' || true)
if [ -n "$STAGED_UI" ] && [ "${XAVIER_HOOK_FULL:-0}" = "1" ]; then
    echo "⚛️  [Pre-Commit] Verificando build de panel-ui..."
    if command -v pnpm >/dev/null 2>&1; then
        (cd panel-ui && pnpm run build) || {
            echo "❌ [Pre-Commit] Fallo en build de panel-ui."
            exit 1
        }
    else
        (cd panel-ui && npm run build) || {
            echo "❌ [Pre-Commit] Fallo en build de panel-ui."
            exit 1
        }
    fi
fi

# 4. Secret scan — catches credentials before they reach origin
if [ -f "scripts/check-secrets.sh" ]; then
    echo "🔐 [Pre-Commit] Ejecutando escaneo de secretos..."
    bash scripts/check-secrets.sh || {
        echo "❌ [Pre-Commit] Fallo en secret scan. Elimina credenciales antes de commitear."
        exit 1
    }
fi

# 5. Guard: never commit SQLite runtime databases or WAL/SHM files
STAGED_DBS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(db|sqlite|sqlite3|sqlite-wal|sqlite-shm|db-wal|db-shm)$' || true)
if [ -n "$STAGED_DBS" ]; then
    echo "❌ [Pre-Commit] SQLite/DB runtime files detectados en staged:"
    echo "$STAGED_DBS"
    echo "   Estos archivos son runtime caches y NUNCA deben commitearse (AGENTS.md §10)."
    exit 1
fi

# 6. Harvest chronicle si existe
if [ -f "./scripts/pre-commit-chronicle.sh" ]; then
    ./scripts/pre-commit-chronicle.sh || true
fi

echo "✅ [Xavier Pre-Commit] Todas las verificaciones locales pasaron exitosamente."
