# Xavier server environment. Copied to /etc/xavier/xavier.env (system) or
# ~/.config/xavier/xavier.env (user) with a freshly generated token.
# Full variable reference: .env.example in the repository.

# Required: the HTTP and MCP surfaces refuse to start without it.
XAVIER_TOKEN=

# Bind address. Keep 127.0.0.1 behind a reverse proxy; 0.0.0.0 exposes the API.
XAVIER_HOST=127.0.0.1
XAVIER_PORT=8006

# Embeddings: point to an Ollama or OpenAI-compatible endpoint
# (see docs/LOCAL_EMBEDDINGS.md for providers and fallbacks).
# XAVIER_EMBEDDING_PROVIDER_MODE=
# XAVIER_EMBEDDING_URL=http://127.0.0.1:11434

RUST_LOG=info
