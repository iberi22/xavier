{
  "name": "xavier-panel-ui",
  "private": true,
  "version": "0.2.14",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.cpSync('build', 'dist', { recursive: true });\"",
    "check": "pnpm run biome:check && pnpm run typecheck && pnpm run build",
    "biome:check": "biome check src/App.tsx src/main.tsx playwright.config.ts tests/generative-ui.spec.ts",
    "biome:write": "biome check --write src/App.tsx src/main.tsx playwright.config.ts tests/generative-ui.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.generative.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e:generative": "playwright test",
    "tauri:build:desktop": "tauri build"
  },
  "dependencies": {
    "@swal/maloca-embed": "workspace:*",
    "@swal/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "lucide-react": "1.45.0",
    "motion": "13.2.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-force-graph-2d": "1.29.1",
    "recharts": "^3.10.1",
    "tailwindcss": "4.3.3",
    "zustand": "^5.0.15",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/node": "^11.1.5",
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "astro": "^7.3.2",
    "defu": "^6.1.5",
    "jsdom": "^30.0.1",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.28",
    "typescript": "^5.8.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
