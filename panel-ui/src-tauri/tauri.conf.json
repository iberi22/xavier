{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xavier",
  "version": "0.1.0",
  "identifier": "com.swalsystems.xavier",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://127.0.0.1:4174",
    "beforeDevCommand": "cd .. \u0026\u0026 cd panel-ui \u0026\u0026 pnpm run dev",
    "beforeBuildCommand": "cd .. \u0026\u0026 cd panel-ui \u0026\u0026 pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "xavier",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/xavier"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
