{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "xavier-ui-base",
  "title": "Xavier2 Generative UI - Base Schema",
  "description": "Schema base para todos los componentes UI generados por el agente",
  "type": "object",
  "required": ["component"],
  "properties": {
    "component": {
      "type": "string",
      "enum": [
        "text-response",
        "data-table",
        "info-card",
        "form-input",
        "progress-bar",
        "code-block",
        "timeline",
        "confirm-dialog",
        "status-badge",
        "chart-bar",
        "list-group"
      ],
      "description": "Tipo de componente UI a renderizar"
    },
    "id": {
      "type": "string",
      "description": "Identificador único opcional"
    },
    "style": {
      "type": "string",
      "description": "Variante de estilo del componente"
    }
  }
}
