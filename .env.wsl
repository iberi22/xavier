# Xavier Environment for WSL
XAVIER_TOKEN=dev-token
XAVIER_LOG_LEVEL=info
XAVIER_DATA_DIR=/home/belal/.xavier/data
XAVIER_EMBEDDING_PROVIDER_MODE=cloud
XAVIER_EMBEDDING_URL=https://openrouter.ai/api/v1/embeddings
XAVIER_EMBEDDING_MODEL=text-embedding-3-small
XAVIER_EMBEDDING_DIMENSIONS=1536
XAVIER_EMBEDDING_API_FLAVOR=openai
XAVIER_EMBEDDING_CACHE_ENABLED=true
# API key stored encrypted in Xavier vault: xavier vault set embedding_api_key <key>
