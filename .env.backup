# Xavier credentials
XAVIER_TOKEN=xavier-local-token

# Embedding configuration - Infinity Local (Primario)
XAVIER_EMBEDDING_PROVIDER_MODE=local
XAVIER_EMBEDDING_LOCAL_URL=http://localhost:7999/v1/embeddings
XAVIER_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
XAVIER_EMBEDDING_DIMENSIONS=1024
XAVIER_EMBEDDING_API_FLAVOR=openai

# GPU acceleration - NO CUDA, wgpu for AMD RX 6600
XAVIER_GLLM_DEVICE=cpu

# Embedding cache
XAVIOR_EMBEDDING_CACHE_ENABLED=true
XAVIOR_EMBEDDING_CACHE_PATH=E:\scripts-python\xavier\data\embedding-cache.db

# Fallback cloud (OpenRouter) cuando Infinity no responda
XAVIER_EMBEDDING_FALLBACK_ENDPOINT=https://openrouter.ai/api/v1
XAVIER_EMBEDDING_FALLBACK_MODEL=text-embedding-3-small
XAVIER_EMBEDDING_FALLBACK_DIM=1536
XAVIER_EMBEDDING_FALLBACK_API_FLAVOR=openai
XAVIER_OPENAI_KEY=sk-or-***7d81

# Tavily API
TAVILY_API_KEY=tvly-d***7Hn5
